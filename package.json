{
  "name": "jarvis-ops-os",
  "private": true,
  "version": "1.0.0",
  "description": "JARVIS Operations OS — AI-powered desktop command centre",
  "main": "dist-electron/main.js",
  "author": "JARVIS Operator",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c green,cyan \"pnpm run dev:vite\" \"wait-on tcp:127.0.0.1:5173 && pnpm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && electron .",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\"",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "start": "electron .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.jarvis.ops-os",
    "productName": "JARVIS Operations OS",
    "copyright": "JARVIS Operator",
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "mt5_bridge/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mt5_bridge",
        "to": "mt5_bridge",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowDirChange": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS",
      "installerIcon": "build-assets/icon.ico",
      "uninstallerIcon": "build-assets/icon.ico",
      "installerSidebar": "build-assets/installer-sidebar.bmp",
      "license": "build-assets/LICENSE.txt",
      "include": "build-assets/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "build-assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-assets/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "lightweight-charts": "^5.2.0",
    "node-cron": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "3.2.6",
    "concurrently": "^9.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.3.4",
    "vitest": "^3.2.6",
    "wait-on": "^9.0.10"
  }
}
