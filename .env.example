# Anthropic API key — required for live Claude calls (Briefings, Console, Live Workflows).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional override — default is "claude-haiku-4-5"
JARVIS_MODEL=claude-haiku-4-5

# Path to your agents folder (contains *.agent.md files)
JARVIS_AGENTS_PATH=C:\path\to\your\agents

# Path to your skills-index.json (built by build-skills-index.mjs)
JARVIS_SKILLS_INDEX=C:\path\to\skills-index.json
