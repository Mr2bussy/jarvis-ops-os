# ─────────────────────────────────────────────────────────────────────────────
# JARVIS Operations OS — environment configuration (DEV fallback)
#
# PREFERRED: configure keys in-app via Admin → Models. Those are stored ENCRYPTED
# in the OS keychain (Electron safeStorage), not in plaintext. This .env file is a
# DEV convenience fallback only and is git-ignored. Never commit a filled-in .env.
# Any key set in the app overrides the matching value here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core LLM (Anthropic) ─────────────────────────────────────────────────────
# Required for live Claude calls (Briefings, Console, Live Workflows, chat).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default model if unset: claude-haiku-4-5
JARVIS_MODEL=claude-haiku-4-5

# ── Workspace integration ────────────────────────────────────────────────────
# Folder containing your *.agent.md files (Arsenal/Agents scanner reads these).
JARVIS_AGENTS_PATH=
# Path to skills-index.json (built by build-skills-index.mjs). Its directory is
# also added to the file-IO allow-list.
JARVIS_SKILLS_INDEX=

# ── Google Gemini (voice mode + STT fallback) ────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_STT_MODEL=gemini-2.0-flash-lite

# ── GitHub Models (voice fallback, ~free with GitHub Pro) ────────────────────
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4.1-mini
GITHUB_FALLBACK_MODEL=gpt-4o-mini

# ── Qwen / Alibaba DashScope (OpenAI-compatible, free tier) ──────────────────
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# ── OpenAI (optional; OpenAI-compatible router) ──────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Mistral (optional) ───────────────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── DeepSeek (optional) ──────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Ollama (local, zero cost, zero rate-limits) ──────────────────────────────
# Set OLLAMA_BASE_URL to route the main completion path through Ollama.
OLLAMA_BASE_URL=
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3-coder-next
OLLAMA_STT_MODEL=whisper

# ── Web search (optional; falls back to DuckDuckGo if unset) ─────────────────
BRAVE_API_KEY=

# ── n8n automation (optional; provider connectivity test) ────────────────────
N8N_WEBHOOK_URL=
N8N_API_KEY=

# ── Composio (485+ app integrations: catalog + action execution) ─────────────
# Get a key at https://app.composio.dev. Needed to fetch the LIVE catalog and run
# actions; without it the Integrations screen shows "not connected".
COMPOSIO_API_KEY=

# ── MetaTrader 5 bridge ──────────────────────────────────────────────────────
# Host/port are normally set in-app (Trading screen) and stored encrypted.
MT5_HOST=localhost
MT5_PORT=1234
# JARVIS_BRIDGE_TOKEN is GENERATED AUTOMATICALLY by the app and injected into the
# bridge process — do NOT set it by hand unless you run bridge.py standalone and
# want to enforce auth manually. Leave blank for normal use.
JARVIS_BRIDGE_TOKEN=
